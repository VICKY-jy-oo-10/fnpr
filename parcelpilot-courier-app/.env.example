# Copy this file to .env before running locally.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
DB_PATH=./data/parcelpilot.sqlite
DEMO_MODE=true
# Used only by the development OTP flow. Never use a fixed OTP in production.
DEMO_OTP=483921
COOKIE_SECURE=false
UPLOAD_MAX_MB=5
